// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--enable-proposed-api=vicanent.gcmp"],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "preLaunchTask": "npm: compile:dev",
            "sourceMaps": true,
            "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
        },
        {
            "name": "Run Extension (Watch Mode)",
            "type": "extensionHost",
            "request": "launch",
            "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--enable-proposed-api=vicanent.gcmp"],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "preLaunchTask": "esbuild: watch-dev",
            "sourceMaps": true,
            "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
        },
        {
            "name": "Run FIM/NES Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/extensions/gcmp-fim-nes",
                "--enable-proposed-api=vicanent.gcmp"
            ],
            "outFiles": ["${workspaceFolder}/extensions/gcmp-fim-nes/dist/**/*.js"],
            "preLaunchTask": "esbuild: compile-dev-fim-nes",
            "sourceMaps": true,
            "resolveSourceMapLocations": ["${workspaceFolder}/extensions/gcmp-fim-nes/**", "!**/node_modules/**"]
        },
        {
            "name": "Run FIM/NES Extension (Watch Mode)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/extensions/gcmp-fim-nes",
                "--enable-proposed-api=vicanent.gcmp"
            ],
            "outFiles": ["${workspaceFolder}/extensions/gcmp-fim-nes/dist/**/*.js"],
            "preLaunchTask": "esbuild: watch-fim-nes",
            "sourceMaps": true,
            "resolveSourceMapLocations": ["${workspaceFolder}/extensions/gcmp-fim-nes/**", "!**/node_modules/**"]
        },
        {
            "name": "Run Both Extensions",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--extensionDevelopmentPath=${workspaceFolder}/extensions/gcmp-fim-nes",
                "--enable-proposed-api=vicanent.gcmp"
            ],
            "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/extensions/gcmp-fim-nes/dist/**/*.js"],
            "preLaunchTask": "esbuild: compile-dev-all",
            "sourceMaps": true,
            "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
        },
        {
            "name": "Run Both Extensions (Watch Mode)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--extensionDevelopmentPath=${workspaceFolder}/extensions/gcmp-fim-nes",
                "--enable-proposed-api=vicanent.gcmp"
            ],
            "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/extensions/gcmp-fim-nes/dist/**/*.js"],
            "preLaunchTask": "esbuild: watch-all",
            "sourceMaps": true,
            "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
        },
        {
            "name": "Extension Tests",
            "type": "extensionHost",
            "request": "launch",
            "testConfiguration": "${workspaceFolder}/.vscode-test.mjs",
            "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--enable-proposed-api=vicanent.gcmp"],
            "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/out/integration/**/*.js"],
            "preLaunchTask": "npm: compile:vscode-test",
            "sourceMaps": true
        }
    ]
}
