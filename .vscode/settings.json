// Place your settings in this file to overwrite default and user settings.
{
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.exclude": {
        "out": true, // hide the old "out" folder since we use esbuild now
        "dist": false, // show the "dist" folder with esbuild compiled JS files
        "discuss/temp": true,
        "logs": true
    },
    "search.exclude": {
        "node_modules": true,
        "out": true, // exclude old "out" folder from search
        "dist": true, // exclude "dist" folder from search results
        "discuss/temp": false,
        "logs": false
    },
    // Turn off tsc task auto detection since we use esbuild
    "js/ts.tsc.autoDetect": "off",
    // 编辑器配置：统一使用4个空格缩进
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "[typescript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[typescriptreact]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[javascript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[json]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.wordWrap": "off"
    },
    "[jsonc]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    // 调试配置优化
    "debug.openDebug": "openOnDebugBreak",
    // 1.139+默认启用，会造成F5启动调试宿主崩溃
    "debug.javascript.enableNetworkView": false,
    // esbuild 相关优化
    "eslint.validate": ["javascript", "typescript"],
    "js/ts.preferences.includePackageJsonAutoImports": "auto",
    // 为提供商配置提供 JSON Schema 校验和提示
    "json.schemas": [
        {
            "fileMatch": ["src/providers/config/*.json"],
            "url": "./.vscode/providerConfig.schema.json"
        }
    ],
    // model-sync 的手工维护配置允许 JSONC 注释（加载时由 jsonc.ts 剥离）
    "files.associations": {
        "**/scripts/model-sync/config/*.json": "jsonc"
    }
}
