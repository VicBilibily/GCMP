{
    // 同步策略：adapter/endpoint/target 必填；models 登记 ref 映射与 overrides/removeFields；extra 登记 remote-extra 归属
    "hyper": {
        "adapter": "hyper",
        "endpoint": "https://hyper.charm.land/v1/models",
        "target": "src/providers/config/hyper.json",
        "nameSuffix": "(Hyper)",
        "tooltipPrefix": "Charm Hyper",
        "excludedModelIds": ["prism"],
        "defaults": {
            "sdkMode": "openai-sse"
        },
        "models": {
            "deepseek-v4.1-flash": {
                "ref": "deepseek/deepseek-v4.1-flash"
            },
            "deepseek-v4.1-flash-1017": {
                "ref": "deepseek/deepseek-v4.1-flash-1017"
            },
            "glm-5.3": {
                // 远端误报 vision:true（智谱官方及其余来源均为 false），钉住待上游修正后移除
                "overrides": {
                    "capabilities": { "toolCalling": true, "imageInput": false }
                }
            },
            "inkling": {
                "ref": "thinkingmachines/inkling"
            }
        },
        "sunsetVendor": "Hyper"
    },
    "opencode-go": {
        "adapter": "openai-model-list",
        "endpoint": "https://opencode.ai/inference/go/v1/models",
        "target": "src/providers/config/opencode.json",
        "nameSuffix": "(Go)",
        "tooltipPrefix": "OpenCode Go 套餐",
        "localIdSuffix": "-go",
        // models 清单端点为协议无关根（inference/go/v1），条目归属以 OpenAI 兼容根为基准；
        // Anthropic / Gemini 系条目端点不同源，由 modelRules 命中归属
        "localBaseUrl": "https://opencode.ai/inference/go/openai/v1",
        "excludedModelIds": [],
        "excludedModelIdPrefixes": ["minimax-m2.5", "deepseek-flash", "glm-5.1", "qwen3.6"],
        // 免费模型不入预置，-free 后缀一律过滤
        "excludedModelIdSuffixes": ["-free", "-alpha"],
        "defaults": {
            "sdkMode": "openai-sse",
            "baseUrl": "https://opencode.ai/inference/go/openai/v1"
        },
        "modelRules": [
            {
                // Claude 系列走 Anthropic 端点
                "idPrefix": "claude-",
                "overrides": {
                    "baseUrl": "https://opencode.ai/inference/go/anthropic",
                    "sdkMode": "anthropic",
                    "extraBody": { "thinking": { "type": "adaptive" } }
                }
            },
            {
                // MiniMax / Qwen 系列官方走 Anthropic 兼容端点
                "idPrefixes": ["minimax-", "qwen3."],
                "overrides": {
                    "baseUrl": "https://opencode.ai/inference/go/anthropic",
                    "sdkMode": "anthropic"
                }
            },
            {
                // Gemini 4 系走 Google 兼容端点，原生 streamGenerateContent + thinkingConfig 透传思考档位
                "idPrefix": "gemini-",
                "overrides": {
                    "baseUrl": "https://opencode.ai/inference/go/google/v1beta",
                    "sdkMode": "gemini-sse"
                }
            }
        ],
        "models": {
            "mimo-v2.6-pro": { "ref": "xiaomi/mimo-v2.6-pro" },
            "mimo-v2.6-flash": { "ref": "xiaomi/mimo-v2.6-flash" },
            "gpt-6-luna": { "ref": "openai/gpt-6-luna" },
            "gemini-4-argon-contributor": { "ref": "google/gemini-4-argon-contributor" },
            "step-5-preview": { "ref": "stepfun/step-5-preview" }
        }
    },
    "commandcode": {
        "adapter": "commandcode",
        "endpoint": "https://api.commandcode.ai/provider/v1/models",
        "target": "src/providers/config/commandcode.json",
        "nameSuffix": "(CmdC)",
        "tooltipPrefix": "CommandCode GOAT Plan",
        "excludedModelIds": [],
        "excludedModelIdPrefixes": [
            // 默认过滤，除非在 models 中手动登记包含
            "claude-",
            "gpt-",
            "google/",
            "MiniMaxAI/MiniMax-M2", // M2 系列已下线
            // qwen3.6/3.7 系列不预置
            "Qwen/Qwen3.7-",
            "Qwen/Qwen3.6-",
            "meta/muse-spark-1.1$", // 无对应默认源
            "sakana/", // 小众作者暂不接入
            "inclusionai/", // ling-3.0-flash-sante 为医疗调优模型
            "Qwen/Qwen3.8-Omni" // 全模态模型，暂未完整支持接入
        ],
        "excludedModelIdSuffixes": [":free"], // 限时免费的隐身预览模型默认过滤（数据可能用于训练）
        "defaults": {
            "sdkMode": "openai-sse"
        },
        // 免费模型不入预置，仅在 remote-extra 提供
        "extra": {
            "poolside/laguna-s-2.1-free": { "reason": "online-only" }
        },
        // commandcode 仅提供 chat 端点，Muse Spark 一族回退为 chat 模式并剔除 Responses 专有字段
        "modelRules": [
            {
                "idPrefix": "meta/muse-spark-",
                "overrides": { "sdkMode": "openai-sse" },
                "removeFields": ["reasoningEffort", "reasoningDefault", "thinkingFormat", "extraBody"]
            },
            // 网关不支持 none 推理档，钉掉默认源中的对应选项
            {
                "idPrefixes": ["deepseek/deepseek-v4-flash", "deepseek/deepseek-v4-pro"],
                "overrides": { "reasoningEffort": ["high", "max"] }
            },
            // 网关不支持关闭思考
            {
                "idPrefixes": ["xiaomi/mimo-v2", "tencent/hy4-preview", "meituan/LongCat-2.0"],
                "removeFields": ["thinking", "thinkingFormat"]
            }
        ],
        "models": {
            "Qwen/Qwen3.8-Max-0902": { "ref": "qwen/qwen3.8-max-0902" },
            "Qwen/Qwen3.8-Max-Prime": { "ref": "qwen/qwen3.8-max-prime", "localId": "qwen-3.8-max-prime" },
            "meta/muse-spark-open": { "ref": "meta/muse-spark-open", "localId": "muse-spark-open" },
            "meta/muse-wonder-1.0": { "ref": "meta/muse-wonder-1.0", "localId": "muse-wonder-1.0" },
            "nvidia/nemotron-3.5-super-vl": {
                "ref": "nvidia/nemotron-3.5-super-vl",
                "localId": "nemotron-3.5-super-vl"
            },
            "meituan/LongCat-2.0": { "ref": "meituan/longcat-2.0", "localId": "longcat-2.0" },
            "poolside/laguna-s-2.1-free": { "ref": "poolside/laguna-s-2.1", "localId": "laguna-s-2.1-free" },
            "xai/grok-4.7": { "localId": "grok-4.7" },
            "xiaomi/mimo-v2.6-pro": { "localId": "mimo-v2.6-pro" },
            "xiaomi/mimo-v2.6-flash": { "localId": "mimo-v2.6-flash" },
            "xiaomi/mimo-v2.6-pro-ultraspeed": { "localId": "mimo-v2.6-pro-ultraspeed" },
            "z-ai/glm-5.3-flashx": { "ref": "zhipu/glm-5.3-flashx", "localId": "glm-5.3-flashx" },
            "stepfun/Step-5-Preview": { "ref": "stepfun/step-5-preview", "localId": "step-5-preview" },
            "deepseek/deepseek-v4.1-flash-fast": { "localId": "deepseek-v4.1-flash-fast" },
            "minimax/minimax-m3.1-flash": {
                "localId": "minimax-m3.1-flash",
                // 远端清单无定价，按 MiniMax 官方参考价展示
                "overrides": { "tokenPricing": [0.15, 0.6, 0.015] }
            },
            "mistral/mistral-large-4": { "localId": "mistral-large-4" }
        }
    },
    // ClinePass：成员与规格均取自 models.dev 的 cline-pass 目录（端点与 provider baseUrl 不同源，用 localBaseUrl 归属）；
    // 官方推荐清单已移除的模型保留在 excludedModelIds 以防回流。
    // models.dev 声明了推理档位，但模型选择器默认档取决于本地顺序，故 reasoningEffort 一律人工维护，
    // 档位差异以“保留本地配置，请人工确认”提示；reasoningFormat 与官方参考价不符的定价在此用 overrides 钉住。
    "clinepass": {
        "adapter": "models-dev",
        "endpoint": "https://models.dev/api.json",
        "modelsDevProvider": "cline-pass",
        "localBaseUrl": "https://api.cline.bot/api/v1",
        "target": "src/providers/config/clinepass.json",
        "nameSuffix": "(ClinePass)",
        "tooltipPrefix": "ClinePass",
        "excludedModelIds": [
            "cline-pass/glm-5.2",
            "cline-pass/kimi-k2.6",
            "cline-pass/kimi-k2.7-code",
            "cline-pass/deepseek-v4-flash"
        ],
        "defaults": {
            "sdkMode": "openai-sse"
        },
        "models": {
            "cline-pass/deepseek-v4-pro": {
                "overrides": {
                    "tokenPricing": {
                        "pricing": [0.66, 1.98, 0.022],
                        "tiers": [{ "cron": "* 9-11,14-17 * * 1-5", "pricing": 2 }]
                    }
                }
            },
            // ClinePass 是仓库内唯一使用 nested 推理请求格式的提供方（其余提供方均为 flat 缺省），
            // 故新增推理模型一律按该约定钉住 reasoningFormat
            "cline-pass/mimo-v2.6-flash": { "overrides": { "reasoningFormat": "nested" } },
            "cline-pass/mimo-v2.6-pro": { "overrides": { "reasoningFormat": "nested" } }
        }
    }
}
