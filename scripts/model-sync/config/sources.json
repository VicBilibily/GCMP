{
    // 同步策略：adapter/endpoint/target 必填；models 登记 ref 映射与 overrides/removeFields；extra 登记 remote-extra 归属
    "hyper": {
        "adapter": "hyper",
        "endpoint": "https://hyper.charm.land/v1/models",
        "target": "src/providers/config/hyper.json",
        "nameSuffix": "(Hyper)",
        "tooltipPrefix": "Charm Hyper",
        "excludedModelIds": [],
        "defaults": {
            "sdkMode": "openai-sse"
        },
        "models": {
            "deepseek-v4.1-flash": {
                "ref": "deepseek/deepseek-v4.1-flash",
                "overrides": {
                    "reasoningEffort": ["high", "xhigh", "low"]
                }
            },
            "glm-5.3": {
                // 远端误报 vision:true（智谱官方及其余来源均为 false），钉住待上游修正后移除
                "overrides": {
                    "capabilities": { "toolCalling": true, "imageInput": false }
                }
            },
            "inkling": {
                "ref": "thinkingmachines/inkling"
            }
        },
        "sunsetVendor": "Hyper"
    },
    "opencode-zen": {
        "adapter": "openai-model-list",
        "endpoint": "https://opencode.ai/zen/v1/models",
        "target": "src/providers/config/opencode.json",
        "nameSuffix": "(Zen)",
        "tooltipPrefix": "OpenCode",
        "localIdSuffix": "-zen",
        "excludedModelIds": [],
        // 前缀命中即静默跳过新增（不警告、不移除既有条目）；以 $ 结尾为精确匹配（避免 glm-5 误伤 glm-5.3）
        "excludedModelIdPrefixes": [
            "claude-",
            "gpt-",
            "gemini-",
            "qwen", // qwen 系列模型在 zen 中基本报余额不足
            "kimi-k2.5",
            "grok-4.5",
            "glm-5$",
            "glm-5.1$",
            "minimax-m2.5",
            "big-pickle",
            "deepseek-v4-flash-vision-exp",
            // jev 是 System One 评分模型（走 /systemone 专用端点），非聊天模型无法接入
            "jev-"
        ],
        // zen 明确禁止第三方调用免费模型，-free 后缀一律过滤
        "excludedModelIdSuffixes": ["-free"],
        "defaults": {
            "sdkMode": "openai-sse"
        },
        "models": {
            "muse-spark-1.3": { "ref": "meta/muse-spark-1.3" },
            "muse-spark-1.2": { "ref": "meta/muse-spark-1.2" },
            "glm-5.3": { "ref": "zhipu/glm-5.3" },
            "glm-5.3-flash": { "ref": "zhipu/glm-5.3-flash" },
            "deepseek-v4.1-flash": { "ref": "deepseek/deepseek-v4.1-flash" }
        }
    },
    "opencode-go": {
        "adapter": "openai-model-list",
        "endpoint": "https://opencode.ai/zen/go/v1/models",
        "target": "src/providers/config/opencode.json",
        "nameSuffix": "(Go)",
        "tooltipPrefix": "OpenCode Go 套餐",
        "localIdSuffix": "-go",
        "excludedModelIds": [],
        "excludedModelIdPrefixes": [
            "minimax-m2.5",
            "mimo-v2-pro",
            "mimo-v2-omni",
            "hy3-preview",
            "omen-alpha",
            "deepseek-flash",
            "kimi-k2.5",
            "qwen3.5-plus",
            "grok-4.5",
            // 已在 go 下线但仍挂在远端列表（$ 精确匹配，避免误伤 glm-5.2/5.3）
            "glm-5$",
            "glm-5.1$"
        ],
        "defaults": {
            "sdkMode": "openai-sse",
            "baseUrl": "https://opencode.ai/zen/go/v1"
        },
        "models": {
            "mimo-v2.6-pro": { "ref": "xiaomi/mimo-v2.6-pro" },
            "mimo-v2.6-flash": { "ref": "xiaomi/mimo-v2.6-flash" }
        }
    },
    "commandcode": {
        "adapter": "commandcode",
        "endpoint": "https://api.commandcode.ai/provider/v1/models",
        "target": "src/providers/config/commandcode.json",
        "nameSuffix": "(CmdC)",
        "tooltipPrefix": "CommandCode GOAT Plan",
        "excludedModelIds": [],
        "excludedModelIdPrefixes": [
            // 默认过滤，除非在 models 中手动登记包含
            "claude-",
            "gpt-",
            "google/",
            "MiniMaxAI/MiniMax-M2", // M2 系列已下线
            // qwen3.6/3.7 系列不预置
            "Qwen/Qwen3.7-",
            "Qwen/Qwen3.6-",
            "meta/muse-spark-1.1$", // 无对应默认源
            "sakana/", // 小众作者暂不接入
            "inclusionai/", // ling-3.0-flash-sante 为医疗调优模型
            "Qwen/Qwen3.8-Omni" // 全模态模型，暂未完整支持接入
        ],
        "defaults": {
            "sdkMode": "openai-sse"
        },
        // 免费模型不入预置，仅在 remote-extra 提供
        "extra": {
            "poolside/laguna-s-2.1-free": { "reason": "online-only" }
        },
        // commandcode 仅提供 chat 端点，Muse Spark 一族回退为 chat 模式并剔除 Responses 专有字段
        "modelRules": [
            {
                "idPrefix": "meta/muse-spark-",
                "overrides": { "sdkMode": "openai-sse" },
                "removeFields": ["reasoningEffort", "reasoningDefault", "thinkingFormat", "extraBody"]
            },
            // 网关不支持 none 推理档，钉掉默认源中的对应选项
            {
                "idPrefixes": ["deepseek/deepseek-v4-flash", "deepseek/deepseek-v4-pro"],
                "overrides": { "reasoningEffort": ["high", "max"] }
            },
            // 网关不支持关闭思考
            {
                "idPrefixes": ["xiaomi/mimo-v2", "tencent/hy4-preview", "meituan/LongCat-2.0"],
                "removeFields": ["thinking", "thinkingFormat"]
            }
        ],
        "models": {
            "Qwen/Qwen3.8-Max-0902": { "ref": "qwen/qwen3.8-max-0902" },
            "meituan/LongCat-2.0": { "ref": "meituan/longcat-2.0", "localId": "longcat-2.0" },
            "poolside/laguna-s-2.1-free": { "ref": "poolside/laguna-s-2.1", "localId": "laguna-s-2.1-free" },
            "xai/grok-4.7": { "localId": "grok-4.7" },
            "xiaomi/mimo-v2.6-pro": { "localId": "mimo-v2.6-pro" },
            "xiaomi/mimo-v2.6-flash": { "localId": "mimo-v2.6-flash" },
            "xiaomi/mimo-v2.6-pro-ultraspeed": { "localId": "mimo-v2.6-pro-ultraspeed" },
            "z-ai/glm-5.3-flashx": { "ref": "zhipu/glm-5.3-flashx", "localId": "glm-5.3-flashx" },
            "stepfun/Step-5-Preview": { "ref": "stepfun/step-5-preview", "localId": "step-5-preview" }
        }
    }
}
