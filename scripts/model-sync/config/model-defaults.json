    // 模板按引用顺序叠加，优先级：模板 < variantOf 基座 < 条目自身；reasoningDefault 一律内联不进模板
    "$templates": {
        "1m": {
            "contextSize": [1000000, 512000, 400000, 256000, 192000],
            "maxInputTokens": 936000,
            "maxOutputTokens": 64000
